# Copy to .env (git ignored) and fill in what you need.

# Key for the answering LLM provider (feature 6 picks the provider)
PARSEBENCH_ANSWER_API_KEY=

# Where downloaded bundles and model weights live
PARSEBENCH_CACHE_DIR=.cache/parsebench

# Where run folders are written
PARSEBENCH_RUNS_DIR=runs

# CPU thread count for local parsers
PARSEBENCH_THREADS=4

# Only needed to publish bundles to Hugging Face, never to read them
HF_TOKEN=

# Commercial vendor keys are added by feature 20 (for example LLAMAPARSE_API_KEY)
