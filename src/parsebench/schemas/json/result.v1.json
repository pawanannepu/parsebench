{
  "$defs": {
    "Outcome": {
      "description": "Final grade of one (task, parser) pair.",
      "enum": [
        "correct",
        "incorrect",
        "parse_failed",
        "answer_failed"
      ],
      "title": "Outcome",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Graded outcome keyed by (run_id, task_id, parser_id).\n\n`normalized_answer` is None exactly when the outcome is `parse_failed` or\n`answer_failed`. `normalized_gold` is always filled, since the normalizer\nruns on gold even for failed rows.",
  "properties": {
    "doc_id": {
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Doc Id",
      "type": "string"
    },
    "normalized_answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Normalized Answer"
    },
    "normalized_gold": {
      "title": "Normalized Gold",
      "type": "string"
    },
    "outcome": {
      "$ref": "#/$defs/Outcome"
    },
    "parser_id": {
      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
      "title": "Parser Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{8}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "scorer_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Scorer Version",
      "type": "string"
    },
    "task_id": {
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-q[0-9]{2,}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "task_id",
    "doc_id",
    "parser_id",
    "outcome",
    "normalized_answer",
    "normalized_gold",
    "scorer_version"
  ],
  "title": "Result",
  "type": "object"
}
