{
  "$defs": {
    "AnswerErrorKind": {
      "description": "Why an answering call failed.",
      "enum": [
        "timeout",
        "provider_http",
        "transport",
        "malformed_response"
      ],
      "title": "AnswerErrorKind",
      "type": "string"
    },
    "AnswerFailed": {
      "additionalProperties": false,
      "description": "A failed answering call: why it failed, a redacted message, and the HTTP status if any.",
      "properties": {
        "attempts": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "doc_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Doc Id",
          "type": "string"
        },
        "error_kind": {
          "$ref": "#/$defs/AnswerErrorKind"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Http Status"
        },
        "latency_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "message": {
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "parser_id": {
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "title": "Parser Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{8}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-q[0-9]{2,}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "doc_id",
        "parser_id",
        "latency_ms",
        "attempts",
        "status",
        "error_kind",
        "message",
        "http_status"
      ],
      "title": "AnswerFailed",
      "type": "object"
    },
    "AnswerOk": {
      "additionalProperties": false,
      "description": "A model reply. The raw request and response are archived at `raw_call_path`.\n\n`prompt_sha256` hashes the prompt template; `input_sha256` hashes the\ntruncated text actually sent. `answer_text` may be empty (graded incorrect).",
      "properties": {
        "answer_text": {
          "title": "Answer Text",
          "type": "string"
        },
        "attempts": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "doc_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Doc Id",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "input_tokens": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "latency_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "output_tokens": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "parser_id": {
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "title": "Parser Id",
          "type": "string"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "raw_call_path": {
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Raw Call Path",
          "type": "string"
        },
        "raw_call_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Call Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{8}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-q[0-9]{2,}$",
          "title": "Task Id",
          "type": "string"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "run_id",
        "task_id",
        "doc_id",
        "parser_id",
        "latency_ms",
        "attempts",
        "status",
        "answer_text",
        "prompt_sha256",
        "input_sha256",
        "truncated",
        "input_tokens",
        "output_tokens",
        "raw_call_path",
        "raw_call_sha256"
      ],
      "title": "AnswerOk",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/AnswerFailed",
      "ok": "#/$defs/AnswerOk"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/AnswerOk"
    },
    {
      "$ref": "#/$defs/AnswerFailed"
    }
  ]
}
