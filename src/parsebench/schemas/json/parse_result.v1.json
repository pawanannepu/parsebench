{
  "$defs": {
    "ParseErrorKind": {
      "description": "Why a parse failed.",
      "enum": [
        "timeout",
        "parser_error",
        "vendor_http",
        "crash"
      ],
      "title": "ParseErrorKind",
      "type": "string"
    },
    "ParseFailed": {
      "additionalProperties": false,
      "description": "A failed parse: why it failed, a redacted message, and the HTTP status if any.",
      "properties": {
        "attempts": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "doc_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Doc Id",
          "type": "string"
        },
        "error_kind": {
          "$ref": "#/$defs/ParseErrorKind"
        },
        "http_status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Http Status"
        },
        "latency_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "message": {
          "maxLength": 2000,
          "title": "Message",
          "type": "string"
        },
        "parser_id": {
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "title": "Parser Id",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{8}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "doc_id",
        "parser_id",
        "latency_ms",
        "attempts",
        "status",
        "error_kind",
        "message",
        "http_status"
      ],
      "title": "ParseFailed",
      "type": "object"
    },
    "ParseOk": {
      "additionalProperties": false,
      "description": "A successful parse. The text lives at `raw_path` and hashes to `raw_sha256`.\n\n`cost_usd` is None when the vendor did not report a cost; local parsers write 0.",
      "properties": {
        "attempts": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cost Usd"
        },
        "doc_id": {
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Doc Id",
          "type": "string"
        },
        "latency_ms": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Latency Ms",
          "type": "integer"
        },
        "parser_id": {
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
          "title": "Parser Id",
          "type": "string"
        },
        "raw_format": {
          "$ref": "#/$defs/RawFormat"
        },
        "raw_path": {
          "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "title": "Raw Path",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        },
        "run_id": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-f]{8}$",
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "doc_id",
        "parser_id",
        "latency_ms",
        "attempts",
        "status",
        "raw_path",
        "raw_sha256",
        "raw_format",
        "cost_usd"
      ],
      "title": "ParseOk",
      "type": "object"
    },
    "RawFormat": {
      "description": "Format of a parser's stored text output.",
      "enum": [
        "text",
        "markdown"
      ],
      "title": "RawFormat",
      "type": "string"
    }
  },
  "discriminator": {
    "mapping": {
      "failed": "#/$defs/ParseFailed",
      "ok": "#/$defs/ParseOk"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ParseOk"
    },
    {
      "$ref": "#/$defs/ParseFailed"
    }
  ]
}
